# Backend local (padrao)
VITE_PROXY_TARGET=http://127.0.0.1:3000

# Para validar com a API no Azure, substitua o valor acima por:
# VITE_PROXY_TARGET=http://158.158.48.119

# Opcional: acesso direto pelo navegador, sem o proxy do Vite.
# Exige que o backend autorize a origem do frontend via CORS.
# VITE_API_URL=http://127.0.0.1:3000
